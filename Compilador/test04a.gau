entero principal()
{
    entero a, b
    a = 1
    mostrarTexto("bucle -- hasta(a > 0)")
    bucle
    {
        mostrar(a)
        b = numeroExterno(a)
        mostrar(b)
        si (a == 5)
        {
            mostrarTexto("Estamos en la mitad")
        }
        a = a + 1
    } hasta (a > 10)
}
entero numeroExterno(entero numero)
{
    entero resultado
    resultado = numero * 2
    retornar resultado
}